# Variables de entorno para el backend de VOLTIA
DJANGO_SECRET_KEY=clave-super-secreta
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Origenes permitidos para CORS (React en modo dev usa 5173 por defecto)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://frontend:5173

# Credenciales para PostgreSQL 17 (las mismas se usan en docker-compose)
POSTGRES_DB=voltia
POSTGRES_USER=voltia
POSTGRES_PASSWORD=voltia
POSTGRES_HOST=db
POSTGRES_PORT=5432
